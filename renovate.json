{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "fileMatch": ["^kubernetes/.+\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["^kubernetes/.+/values\\.yaml$"]
  },
  "helmv3": {
    "fileMatch": ["^kubernetes/.+/Chart\\.yaml$"]
  }
}
